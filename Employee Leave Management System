<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>ระบบการลาของพนักงาน - LIFF App</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        line: {
                            DEFAULT: '#06C755',
                            dark: '#00B900',
                            light: '#E6F9ED',
                            hover: '#05b34c'
                        },
                        brand: {
                            DEFAULT: '#0056D2', // Company Royal Blue from Logo
                            dark: '#003DA5',
                            light: '#EBF3FE',
                            accent: '#1E6EEB',
                            hover: '#0047AD'
                        }
                    },
                    fontFamily: {
                        sans: ['Prompt', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
        }
        /* Glassmorphism Effect */
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .glass-header {
            background: linear-gradient(135deg, #003DA5 0%, #0056D2 50%, #1E6EEB 160%);
        }
        /* Custom Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.25s ease-out forwards;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex justify-center items-start sm:items-center p-0 sm:p-4">

    <!-- Container simulating Mobile Device Window -->
    <div class="w-full max-w-md bg-slate-50 min-h-screen sm:min-h-[844px] sm:max-h-[900px] sm:rounded-3xl shadow-2xl flex flex-col overflow-hidden relative border border-slate-200">
        
        <!-- MAIN VIEW: MENU HUB -->
        <div id="view-main-menu" class="flex-1 overflow-y-auto pb-6 animate-fade-in">
            <!-- Header Profile Section -->
            <div class="glass-header text-white px-5 pt-6 pb-8 rounded-b-3xl shadow-lg relative overflow-hidden">
                <!-- Background decorative glow -->
                <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
                <div class="absolute -left-10 -top-10 w-32 h-32 bg-blue-400/20 rounded-full blur-xl pointer-events-none"></div>

                <!-- Company Branding Banner -->
                <div class="flex items-center justify-between mb-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-white/15 text-white border border-white/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 mr-1.5 animate-pulse"></span>
                        Alpha D.I. Thailand
                    </span>
                    <span class="text-xs text-blue-100">รหัสพนักงาน: <strong class="text-white">EMP-8842</strong></span>
                </div>

                <!-- Profile Info Card -->
                <div class="flex items-center space-x-4">
                    <div class="relative">
                        <img id="user-avatar" src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?q=80&w=200&auto=format&fit=crop" 
                             alt="User Avatar" 
                             class="w-16 h-16 rounded-full object-cover border-2 border-white/80 shadow-md">
                        <span class="absolute bottom-0 right-0 w-4 h-4 bg-line border-2 border-slate-900 rounded-full" title="Active"></span>
                    </div>
                    <div class="flex-1">
                        <h2 class="text-lg font-bold text-white tracking-tight flex items-center gap-1.5">
                            คุณปริชญา วงศ์สวัสดิ์
                            <i class="fa-solid fa-circle-check text-cyan-400 text-xs"></i>
                        </h2>
                        <p class="text-xs text-blue-100">ตำแหน่ง: Senior Software Engineer</p>
                        <p class="text-xs text-blue-200">แผนก: Information Technology</p>
                    </div>
                </div>

                <!-- Quick Balance Summary Bar -->
                <div class="mt-5 grid grid-cols-3 gap-2 pt-4 border-t border-white/20 text-center">
                    <div class="bg-black/20 rounded-xl p-2 border border-white/10">
                        <p class="text-[10px] text-blue-200">สิทธิลาป่วย</p>
                        <p class="text-sm font-bold text-emerald-300">24 <span class="text-[10px] font-normal text-blue-100">วัน</span></p>
                    </div>
                    <div class="bg-black/20 rounded-xl p-2 border border-white/10">
                        <p class="text-[10px] text-blue-200">สิทธิลากิจ</p>
                        <p class="text-sm font-bold text-amber-300">4.5 <span class="text-[10px] font-normal text-blue-100">วัน</span></p>
                    </div>
                    <div class="bg-black/20 rounded-xl p-2 border border-white/10">
                        <p class="text-[10px] text-blue-200">สิทธิพักร้อน</p>
                        <p class="text-sm font-bold text-cyan-300">8 <span class="text-[10px] font-normal text-blue-100">วัน</span></p>
                    </div>
                </div>
            </div>

            <!-- Main Menu Buttons Grid -->
            <div class="px-5 mt-6">
                <div class="flex items-center justify-between mb-3 px-1">
                    <h3 class="text-sm font-semibold text-slate-700 uppercase tracking-wider">เมนูรายการ (MAIN MENU)</h3>
                    <span class="text-xs text-slate-400">เลือกทำรายการ</span>
                </div>

                <div class="grid grid-cols-1 gap-3">
                    
                    <!-- BUTTON 1: ยื่นใบลา -> redirect to leave-terms.html -->
                    <button onclick="goToLeaveTerms()" 
                            class="group relative overflow-hidden bg-gradient-to-r from-brand to-brand-accent text-white rounded-2xl p-4 shadow-md shadow-brand/25 hover:shadow-lg hover:shadow-brand/35 transition-all active:scale-[0.98] text-left border border-blue-400/40">
                        <div class="absolute right-0 top-0 bottom-0 w-24 bg-white/10 skew-x-12 translate-x-8 group-hover:translate-x-4 transition-transform"></div>
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-md flex items-center justify-center shrink-0 shadow-inner">
                                <i class="fa-solid fa-file-circle-plus text-2xl text-white"></i>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <h4 class="font-bold text-base text-white">1. ยื่นใบลา</h4>
                                    <span class="bg-white/20 text-white text-[10px] px-2 py-0.5 rounded-full font-light">ทำรายการ</span>
                                </div>
                                <p class="text-xs text-blue-100 font-light mt-0.5">กรอกแบบฟอร์มขออนุมัติลาหยุดงาน</p>
                            </div>
                            <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center group-hover:translate-x-1 transition-transform">
                                <i class="fa-solid fa-chevron-right text-sm"></i>
                            </div>
                        </div>
                    </button>

                    <!-- BUTTON 2: ตรวจสอบสิทธิการลาคงเหลือ -> รอพัฒนาอีกหน้านึง -->
                    <button onclick="showUnderDevelopment()" 
                            class="group bg-white rounded-2xl p-4 shadow-sm border border-slate-200/80 hover:border-brand hover:shadow-md transition-all active:scale-[0.98] text-left">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-blue-50 text-brand flex items-center justify-center shrink-0 group-hover:bg-brand group-hover:text-white transition-colors">
                                <i class="fa-solid fa-chart-pie text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-slate-800 text-sm group-hover:text-brand transition-colors">2. ตรวจสอบสิทธิการลาคงเหลือ</h4>
                                <p class="text-xs text-slate-500 font-light mt-0.5">เช็กโควตาลาป่วย ลากิจ ลาพักร้อนคงเหลือ</p>
                            </div>
                            <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center group-hover:text-brand group-hover:bg-brand/10 group-hover:translate-x-1 transition-all">
                                <i class="fa-solid fa-chevron-right text-sm"></i>
                            </div>
                        </div>
                    </button>

                    <!-- BUTTON 3: ตรวจสอบประวัติการลาย้อนหลัง -> รอพัฒนาอีกหน้านึง -->
                    <button onclick="showUnderDevelopment()" 
                            class="group bg-white rounded-2xl p-4 shadow-sm border border-slate-200/80 hover:border-brand hover:shadow-md transition-all active:scale-[0.98] text-left">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center shrink-0 group-hover:bg-brand group-hover:text-white transition-colors">
                                <i class="fa-solid fa-clock-rotate-left text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-slate-800 text-sm group-hover:text-brand transition-colors">3. ตรวจสอบประวัติการลาย้อนหลัง</h4>
                                <p class="text-xs text-slate-500 font-light mt-0.5">ดูสถานะอนุมัติและรายการลาย้อนหลัง</p>
                            </div>
                            <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center group-hover:text-brand group-hover:bg-brand/10 group-hover:translate-x-1 transition-all">
                                <i class="fa-solid fa-chevron-right text-sm"></i>
                            </div>
                        </div>
                    </button>

                    <!-- BUTTON 4: กลับสู่เมนูหลัก -> Redirect back to Main LIFF Hub -->
                    <button onclick="goToMainHub()" 
                            class="group bg-slate-900 text-white rounded-2xl p-4 shadow-sm hover:bg-slate-800 transition-all active:scale-[0.98] text-left border border-slate-800">
                        <div class="flex items-center space-x-4">
                            <div class="w-12 h-12 rounded-xl bg-slate-800 text-slate-300 flex items-center justify-center shrink-0 group-hover:text-red-400 transition-colors">
                                <i class="fa-solid fa-right-from-bracket text-xl"></i>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-slate-100 text-sm">4. กลับสู่เมนูหลัก</h4>
                                <p class="text-xs text-slate-400 font-light mt-0.5">ย้อนกลับไปเมนูหลักของระบบ LIFF</p>
                            </div>
                            <div class="w-8 h-8 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center group-hover:text-white transition-colors">
                                <i class="fa-solid fa-xmark text-sm"></i>
                            </div>
                        </div>
                    </button>

                </div>
            </div>

            <!-- HR Info Box Footer -->
            <div class="px-5 mt-6">
                <div class="bg-blue-50/70 rounded-2xl p-3.5 border border-blue-200/60 flex items-start space-x-3">
                    <i class="fa-solid fa-circle-info text-brand text-lg mt-0.5"></i>
                    <div class="text-xs text-blue-900 leading-relaxed">
                        <strong class="font-semibold block mb-0.5">คำแนะนำจากฝ่ายบุคคล (HR)</strong>
                        การยื่นใบลาล่วงหน้าต้องดำเนินการอย่างน้อย 3 วันทำการ สำหรับการลาป่วยกะทันหัน สามารถยื่นเอกสารย้อนหลังได้ไม่เกิน 2 วัน
                    </div>
                </div>
            </div>
        </div>

        <!-- Custom Toast Notification Modal -->
        <div id="toast-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden animate-fade-in">
            <div class="bg-white rounded-2xl p-6 max-w-xs w-full shadow-2xl text-center space-y-3">
                <div id="toast-icon" class="w-12 h-12 rounded-full bg-blue-100 text-brand flex items-center justify-center mx-auto text-xl">
                    <i class="fa-solid fa-screwdriver-wrench"></i>
                </div>
                <h3 id="toast-title" class="font-bold text-slate-800 text-base">กำลังพัฒนา</h3>
                <p id="toast-message" class="text-xs text-slate-500 leading-relaxed">ระบบส่วนนี้อยู่ระหว่างการพัฒนา</p>
                <button onclick="closeToast()" class="w-full bg-brand text-white font-medium py-2.5 rounded-xl text-xs hover:bg-brand-hover">
                    ตกลง
                </button>
            </div>
        </div>

    </div>

    <!-- Interactive JavaScript -->
    <script>
        // Button 1 Action: Redirect to leave-terms.html
        function goToLeaveTerms() {
            window.location.href = 'leave-terms.html';
        }

        // Button 2 & 3 Action: Show Under Development Alert
        function showUnderDevelopment() {
            showToast('รอพัฒนาอีกหน้านึง', 'ฟังก์ชันส่วนนี้กำลังอยู่ในระหว่างการพัฒนา ขออภัยในความไม่สะดวกค่ะ', 'info');
        }

        // Button 4 Action: Redirect to main LIFF HUB
        function goToMainHub() {
            window.location.href = 'https://alphadithailand-tech.github.io/alpha-liff-app/';
        }

        // Custom Modal Toast Trigger
        function showToast(title, message, type = 'info') {
            const modal = document.getElementById('toast-modal');
            const toastTitle = document.getElementById('toast-title');
            const toastMsg = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastTitle.innerText = title;
            toastMsg.innerText = message;

            if (type === 'info') {
                toastIcon.className = "w-12 h-12 rounded-full bg-blue-100 text-brand flex items-center justify-center mx-auto text-xl";
                toastIcon.innerHTML = `<i class="fa-solid fa-clock-rotate-left"></i>`;
            } else {
                toastIcon.className = "w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto text-xl";
                toastIcon.innerHTML = `<i class="fa-solid fa-check"></i>`;
            }

            modal.classList.remove('hidden');
        }

        function closeToast() {
            document.getElementById('toast-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
